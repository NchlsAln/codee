{
  "name": "codee",
  "version": "0.9.0-beta.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "apps/*/webview-ui",
    "packages/*",
    "packages/languages/*",
    "tools/*"
  ],
  "engines": {
    "node": ">=20.0.0 <21.0.0"
  },
  "packageManager": "npm@10.9.3",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:hot": "turbo run dev --parallel --filter=codee-vscode --filter=@codee/core-engine --filter=@codee/languages",
    "build": "turbo run build",
    "build:prod": "cross-env NODE_ENV=production turbo run build",
    "build:webview": "npm --prefix apps/codee-vscode/webview-ui run build",
    "test": "turbo run test",
    "test:watch": "npm --prefix packages/core-engine run test:watch",
    "test:unit": "turbo run test:unit --filter=@codee/core-engine --filter=@codee/languages",
    "test:integration": "turbo run test:integration --filter=@codee/core-engine",
    "test:extension": "turbo run test:extension --filter=codee-vscode",
    "test:e2e": "npm run build:webview && playwright test -c e2e/playwright.config.ts",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:extension && npm run test:e2e",
    "benchmark": "turbo run benchmark --filter=@codee/core-engine",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "package": "turbo run package",
    "package:desktop": "turbo run package --filter=@codee/codee-desktop",
    "package:extension": "turbo run package --filter=codee-vscode",
    "assets:optimize": "node tools/build-config/optimize-assets.cjs",
    "release:notes": "conventional-changelog -p angular -r 2 -i CHANGELOG.md -s",
    "release:version": "standard-version",
    "format": "prettier -w .",
    "prepare": "husky install",
    "generate:language": "node tools/scripts/generate-language.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.43.0",
    "@types/node": "^25.2.3",
    "@types/jest": "^29.5.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "conventional-changelog-cli": "^5.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "esbuild": "^0.21.0",
    "electron-builder": "^24.9.0",
    "glob": "^10.3.0",
    "husky": "^9.0.0",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.0",
    "standard-version": "^9.5.0",
    "svgo": "^3.0.0",
    "ts-jest": "^29.1.0",
    "turbo": "^2.0.0",
    "typescript": "^5.3.0",
    "vsce": "^2.15.0"
  }
}
