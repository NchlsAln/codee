{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "baseUrl": ".",
    "paths": {
      "@codee/languages": ["packages/languages/src"],
      "@codee/lang-common": ["packages/languages/common/src"],
      "@codee/lang-python": ["packages/languages/python/src"],
      "@codee/lang-typescript": ["packages/languages/typescript/src"]
    },
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  }
}
